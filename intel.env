## Set number of threads.
## Note: prefer the number of physical cores. Overbooking the CPU degrades performance notably.
LOCALAI_THREADS=16

## Specify a different bind address (defaults to ":8080")
LOCALAI_ADDRESS=:38078

## Default models context size
LOCALAI_CONTEXT_SIZE=8192  # Set or uncomment if needed

## Define galleries.
## models will to install will be visible in `/models/available`
LOCALAI_GALLERIES=[{"name":"localai", "url":"github:mudler/LocalAI/gallery/index.yaml@master"}]

## CORS settings
#LOCALAI_CORS=true  # Uncomment to enable
#LOCALAI_CORS_ALLOW_ORIGINS=* # Uncomment to enable

## Default path for models
LOCALAI_MODELS_PATH=/models

## Enable debug mode
LOCALAI_LOG_LEVEL=debug

## Specify a build type. Available: cublas, openblas, clblas, sycl_f16
BUILD_TYPE=sycl_f16

## Uncomment and set to true to enable rebuilding from source
REBUILD=false

# COMPEL=1
LOCALAI_SINGLE_ACTIVE_BACKEND=false

## Enable go tags
## stablediffusion: image generation with stablediffusion
## tts: enables text-to-speech with go-piper 
## p2p: enable distributed inferencing
## (requires REBUILD=true if adding features)
# GO_TAGS= # Add tags like stablediffusion, tts, p2p as needed

## Path where to store generated images
#LOCALAI_IMAGE_PATH=/tmp/generated/images # Set a path


## Specify a default upload limit in MB (whisper)
#LOCALAI_UPLOAD_LIMIT= # Set a limit if required


## List of external GRPC backends
#LOCALAI_EXTERNAL_GRPC_BACKENDS= # Add backends if needed


### Advanced settings ###


### Huggingface cache for models
HUGGINGFACE_HUB_CACHE=/models/huggingface


### Python backends GRPC max workers
PYTHON_GRPC_MAX_WORKERS=4


### Define the number of parallel LLAMA.cpp workers (Defaults to 1)
LLAMACPP_PARALLEL=1


### Enable to run parallel requests
LOCALAI_PARALLEL_REQUESTS=false


### Watchdog settings

LOCALAI_WATCHDOG_IDLE=true


LOCALAI_WATCHDOG_IDLE_TIMEOUT=10m


LOCALAI_WATCHDOG_BUSY=true


LOCALAI_WATCHDOG_BUSY_TIMEOUT=10m

#LOCALAI_FEDERATED=true
#LOCALAI_P2P=true
#LOCALAI_P2P_TOKEN=""


#FEDERATED_SERVER=true # Uncomment to enable federation server

