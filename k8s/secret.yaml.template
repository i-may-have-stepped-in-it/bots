# Copy to secret.yaml and fill in values — never commit secret.yaml
# Generate base64: echo -n 'value' | base64
#
# Alternatively, create from file:
#   kubectl create secret generic jennifer-config \
#     --from-file=config.json=./config/config.json \
#     -n jennifer --dry-run=client -o yaml > secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: jennifer-config
  namespace: jennifer
type: Opaque
data:
  # base64-encoded content of config/config.json
  config.json: <BASE64_ENCODED_CONFIG_JSON>
